---
// Capul paginilor interioare: aceeași poză a Ludușului sub negru, titlu alb și firul paginii.
import { Image } from 'astro:assets';
import ludus from '../assets/foto/ludus.jpg';
import { u } from '../lib/cale';

interface Props {
  titlu: string;
  text?: string;
}
const { titlu, text } = Astro.props;
---

<section class="cap">
  <Image src={ludus} alt="" class="cap__fundal" widths={[800, 1600]} sizes="100vw" loading="eager" />
  <div class="cadru cap__in">
    <nav aria-label="Fir" class="cap__fir">
      <a href={u('/')}>Acasă</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{titlu}</span>
    </nav>
    <h1>{titlu}</h1>
    {text && <p>{text}</p>}
  </div>
</section>

<style>
  .cap {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ink);
    color: #fff;
  }
  .cap__fundal {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 60%;
  }
  .cap::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 0.75);
  }
  .cap__in {
    padding-block: clamp(48px, 7vw, 88px);
  }
  .cap__fir {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: rgb(255 255 255 / 0.7);
  }
  .cap__fir a:hover {
    color: var(--color-galben);
  }
  .cap__fir [aria-current] {
    color: var(--color-galben);
  }
  h1 {
    margin-top: 14px;
    color: #fff;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.1rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.5px;
  }
  h1::after {
    content: '';
    display: block;
    width: 40px;
    height: 3px;
    margin-top: 16px;
    background: var(--color-galben);
  }
  p {
    max-width: 40rem;
    margin-top: 18px;
    font-size: 17px;
    color: rgb(255 255 255 / 0.85);
  }
</style>
