---
// „Confort, siguranță și disponibilitate non-stop” al referinței (fără „non-stop”: noaptea face doar curse lungi sau programate, 20 nov): mașina iese din marginea stângă | titlu + listă cu bife galbene.
// Poza: cele două mașini ale clientului, de pe flyer.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import masini from '../assets/foto/masini-zi.jpg';

const puncte = ['În oraș și în afara orașului', 'Transfer la aeroport, dus și întors', 'Pentru o persoană sau pentru grupuri', 'Și în weekend; noaptea, curse lungi și programări'];
---

<section class="dif" aria-labelledby="dif-titlu">
  <div class="dif__poza">
    <Image src={masini} alt="Dacia Logan și Ford Focus Kassy Taxi, cu numerele MS 98 KSY și MS 13 KSY" widths={[700, 1100, 1600]} sizes="(min-width: 1024px) 55vw, 100vw" />
  </div>
  <div class="dif__text">
    <h2 id="dif-titlu" class="titlu-sectiune">Confort, siguranță și curse la ora stabilită</h2>
    <p>Indiferent dacă ai nevoie de o cursă până la piață sau de un drum până la Cluj, suntem la un telefon distanță.</p>
    <ul>
      {
        puncte.map((p) => (
          <li>
            <span class="dif__bifa">
              <Icon name="check" class="size-3.5" />
            </span>
            {p}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .dif {
    display: grid;
    align-items: center;
    background: #fafafa;
    overflow: hidden;
  }
  .dif__poza :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1888 / 520;
    object-fit: cover;
  }
  .dif__text {
    width: min(560px, 100% - 32px);
    margin-inline: auto;
    padding-block: 44px 64px;
  }
  .dif__text > p {
    margin-top: 22px;
  }
  .dif__text ul {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }
  .dif__text li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-titlu);
    font-weight: 500;
    font-size: 18px;
    color: var(--color-ink);
  }
  .dif__bifa {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    background: var(--color-galben);
    color: var(--color-ink);
  }
  @media (min-width: 1024px) {
    .dif {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      min-height: 460px;
    }
    .dif__poza {
      align-self: stretch;
      position: relative;
    }
    .dif__poza :global(img) {
      height: 100%;
      aspect-ratio: auto;
      object-position: 30% 60%;
      -webkit-mask-image: linear-gradient(to right, #000 70%, transparent);
      mask-image: linear-gradient(to right, #000 70%, transparent);
    }
    .dif__text {
      width: auto;
      max-width: 560px;
      margin: 0 32px 0 24px;
      padding-block: 64px;
    }
  }
</style>
