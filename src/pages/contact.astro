---
import Layout from '../layouts/Layout.astro';
import PaginaCap from '../components/PaginaCap.astro';
import FormularCursa from '../components/FormularCursa.astro';
import HartaGoogle from '../components/HartaGoogle.astro';
import Icon from '../components/Icon.astro';
import { firma } from '../data';

const blocuri = [
  { icon: 'phone', eticheta: 'Telefon', valoare: firma.telefon, href: `tel:${firma.telefonHref}` },
  { icon: 'phone', eticheta: 'Al doilea telefon', valoare: firma.telefon2, href: `tel:${firma.telefon2Href}` },
  { icon: 'whatsapp', eticheta: 'WhatsApp', valoare: 'Scrie-ne un mesaj', href: `https://wa.me/${firma.whatsapp}` },
  { icon: 'clock', eticheta: 'Program', valoare: 'Ziua, orice cursă. Noaptea (22–6), curse lungi sau programate.' },
  { icon: 'pin', eticheta: 'Adresa', valoare: firma.adresa },
] as const;
---

<Layout title={`Contact ${firma.nume} · taxi Luduș ${firma.telefon}`}>
  <PaginaCap titlu="Contact" text="Cel mai repede ne găsești la telefon. Pentru o cursă programată, completează formularul și primim cererea pe WhatsApp." />

  <section class="cadru contact">
    <div>
      <h2 class="titlu-sectiune">Sună sau scrie-ne</h2>
      <ul class="blocuri">
        {
          blocuri.map((b) => (
            <li class="bloc">
              <span class="bloc__icon">
                <Icon name={b.icon} class="size-5" />
              </span>
              <span>
                <span class="bloc__eticheta">{b.eticheta}</span>
                {'href' in b ? (
                  <a href={b.href} class="bloc__valoare" {...(b.icon === 'whatsapp' ? { target: '_blank', rel: 'noopener' } : {})}>
                    {b.valoare}
                  </a>
                ) : (
                  <span class="bloc__valoare">{b.valoare}</span>
                )}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="harta">
        <HartaGoogle loc={firma.adresaHarta} titlu={`Harta: ${firma.adresa}`} zoom={15} />
      </div>
    </div>
    <FormularCursa id="programare" />
  </section>
</Layout>

<style>
  .contact {
    display: grid;
    gap: 48px;
    padding-block: clamp(56px, 8vw, 96px);
  }
  .blocuri {
    display: grid;
    gap: 14px;
    margin-top: 30px;
  }
  @media (min-width: 560px) {
    .blocuri {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .bloc {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid #ececec;
    border-radius: 10px;
    background: #fff;
  }
  .bloc__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--color-galben);
    color: var(--color-ink);
  }
  .bloc__eticheta {
    display: block;
    font-size: 13px;
    line-height: 1.4;
  }
  .bloc__valoare {
    font-family: var(--font-titlu);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.4;
    color: var(--color-ink);
  }
  a.bloc__valoare:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-galben);
    text-underline-offset: 4px;
  }
  .harta {
    height: 320px;
    margin-top: 24px;
    overflow: hidden;
    border-radius: 10px;
    background: #e9e9e9;
  }
  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
      gap: 64px;
      align-items: start;
    }
  }
</style>
